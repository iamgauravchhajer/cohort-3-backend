# development | test | production
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/downbot

# Generate two different secrets (min 32 chars each): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Required
GROQ_API_KEY=

# Optional
TAVILY_URL=
COHERE_API_KEY=

# Langsmith
LANGSMITH_TRACING=true 
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=production
